  CONTROL "",IDC_SET_CBO_SCOPE,"ComboBox",0x50210003,55,136,88,60,0x00000000
  CONTROL "S&tore:",IDC_SET_STC_STORE,"Static",0x50000202,10,153,43,13,0x00000000
  CONTROL "",IDC_SET_CBO_STORE,"ComboBox",0x50210342,55,153,88,100,0x00000000

  CONTROL "NetCom limits and timeouts",IDC_SET_GRP_NET,"Button",0x50000007,155,4,145,118,0x00000000
