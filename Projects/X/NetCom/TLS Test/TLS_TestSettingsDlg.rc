#define IDC_SET_EDT_TARGET      4009

#define IDC_SET_GRP_ALGS        4012
#define IDC_SET_LST_ALGS        4013
#define IDC_SET_BTN_ALGCLEAR    4014
#define IDC_SET_STC_ALGINFO     4015

#define IDC_SET_GRP_CERT        4020
#define IDC_SET_STC_SEARCH      4021
#define IDC_SET_CBO_SEARCH      4022
#define IDC_SET_STC_VALUE       4023
#define IDC_SET_EDT_VALUE       4024
#define IDC_SET_STC_SCOPE       4025
#define IDC_SET_CBO_SCOPE       4026
#define IDC_SET_STC_STORE       4027
#define IDC_SET_CBO_STORE       4028

