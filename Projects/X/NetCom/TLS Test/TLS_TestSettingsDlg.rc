#define IDC_SET_STC_PORT        4041
#define IDC_SET_EDT_PORT        4042
#define IDC_SET_STC_INACT       4043
#define IDC_SET_EDT_INACT       4044
#define IDC_SET_STC_HSHAKE      4045
#define IDC_SET_EDT_HSHAKE      4046
