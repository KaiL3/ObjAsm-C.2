  CONTROL "&Echo received messages",IDC_SET_CHK_ECHO,"Button",0x50010003,162,140,133,10,0x00000000
  CONTROL "Tric&kle interval [s]:",IDC_SET_STC_TRICKLE,"Static",0x50000202,160,155,82,13,0x00000000
  CONTROL "",IDC_SET_EDT_TRICKLE,"Edit",0x50012080,245,155,48,13,0x00000200

  CONTROL "Algorithms offered by this host (SChannel ALG_IDs)",IDC_SET_GRP_ALGS,"Button",0x50000007,5,180,295,118,0x00000000
  CONTROL "",IDC_SET_LST_ALGS,"ListBox",0x50210943,12,192,200,100,0x00000200
