#define IDC_SET_STC_TRICKLE     4062
#define IDC_SET_EDT_TRICKLE     4063

#define IDC_SET_BTN_DEFAULTS    4070
#define IDC_SET_STC_INFO        4071

IDD_DLG_SETTINGS DIALOGEX 5,5,305,346
CAPTION "Settings"
FONT 9,"Segoe UI",400,0
STYLE 0x90C800C4
EXSTYLE 0x00000001
BEGIN
  CONTROL "TLS",IDC_SET_GRP_TLS,"Button",0x50000007,5,4,145,82,0x00000000
  CONTROL "TLS 1.&0",IDC_SET_CHK_TLS10,"Button",0x50010003,12,16,40,10,0x00000000
  CONTROL "TLS 1.&1",IDC_SET_CHK_TLS11,"Button",0x50010003,55,16,40,10,0x00000000
  CONTROL "TLS 1.&2",IDC_SET_CHK_TLS12,"Button",0x50010003,12,28,40,10,0x00000000
  CONTROL "TLS 1.&3",IDC_SET_CHK_TLS13,"Button",0x50010003,55,28,40,10,0x00000000
  CONTROL "&Mutual authentication",IDC_SET_CHK_MUTUAL,"Button",0x50010003,12,42,133,10,0x00000000
  CONTROL "&Verify server name",IDC_SET_CHK_VERIFY,"Button",0x50010003,12,54,133,10,0x00000000
