  CONTROL "",IDC_SET_EDT_INACT,"Edit",0x50012080,245,33,48,13,0x00000200
  CONTROL "&Handshake timeout [s]:",IDC_SET_STC_HSHAKE,"Static",0x50000202,160,50,82,13,0x00000000
  CONTROL "",IDC_SET_EDT_HSHAKE,"Edit",0x50012080,245,50,48,13,0x00000200
  CONTROL "TLS sh&utdown timeout [s]:",IDC_SET_STC_SHUTDN,"Static",0x50000202,160,67,82,13,0x00000000
  CONTROL "",IDC_SET_EDT_SHUTDN,"Edit",0x50012080,245,67,48,13,0x00000200
  CONTROL "Receive pause timeout [s]:",IDC_SET_STC_PAUSE,"Static",0x50000202,160,84,82,13,0x00000000
  CONTROL "",IDC_SET_EDT_PAUSE,"Edit",0x50012080,245,84,48,13,0x00000200
  CONTROL "&Receive limit [KB]:",IDC_SET_STC_LIMIT,"Static",0x50000202,160,101,82,13,0x00000000
