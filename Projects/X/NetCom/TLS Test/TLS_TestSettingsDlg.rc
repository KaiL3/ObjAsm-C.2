  CONTROL "Timeouts: 0 = off, max. 429 s. Limit: 0 = off. Timeouts and limit apply immediately, TLS settings to new connections.",IDC_SET_STC_INFO,"Static",0x50000000,5,302,295,18,0x00000000

  CONTROL "&Defaults",IDC_SET_BTN_DEFAULTS,"Button",0x50010000,5,326,50,14,0x00000000
  CONTROL "OK",IDOK,"Button",0x50010001,195,326,50,14,0x00000000
  CONTROL "Cancel",IDCANCEL,"Button",0x50010000,250,326,50,14,0x00000000
